// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`CopySessionsFormContainer should create 1`] = `
<copy-sessions-container
  addSessionComponent={[Function Function]}
  businessType$={[Function _Store]}
  courtCentre$={[Function _Store]}
  destroy$={[Function Subject]}
  errors={[Function Array]}
  errors$={[Function _Store]}
  jurisdiction={[Function Function]}
  repeatPattern="undefined"
  route={[Function Object]}
  router={[Function Object]}
  sessionToCopy$={[Function _Store]}
  sessions={[Function Array]}
  store={[Function _MockStore]}
>
  <div
    class="govuk-!-margin-bottom-4"
    pdk-margin-bottom="4"
  >
    <a
      class="govuk-back-link"
      href="javascript:void(0);"
      pdk-back-link=""
    >
      Back
    </a>
  </div><pdk-grid
    class="govuk-grid-row"
    container=""
  >
    <pdk-grid
      class="govuk-grid-column-full"
      full=""
    >
      <h1
        class="govuk-heading-xl"
        pdk-typography="heading-xlarge"
      >
         Copy sessions for Business Type 1 
      </h1>
      <journey-summary>
        <div
          class="govuk-!-margin-bottom-8"
          pdk-margin-bottom="8"
        >
          <h3
            class="govuk-!-margin-bottom-0"
            pdk-margin-bottom="0"
            pdk-typography="heading-medium"
          >
            Court and business type details
          </h3>
          <dl
            class="pdk-summary-list"
            pdk-summary-list=""
          >
            <div
              class="pdk-summary-list__row"
              pdk-summary-list-item=""
            >
              <dt
                class="pdk-summary-list__key"
                pdk-summary-list-key=""
              >
                Court
              </dt>
              <dd
                class="pdk-summary-list__value"
                pdk-summary-list-value=""
              >
                L3 Name
              </dd>
            </div>
            <div
              class="pdk-summary-list__row"
              pdk-summary-list-item=""
            >
              <dt
                class="pdk-summary-list__key"
                pdk-summary-list-key=""
              >
                Business Type
              </dt>
              <dd
                class="pdk-summary-list__value"
                pdk-summary-list-value=""
              >
                Business Type 1
              </dd>
            </div>
          </dl>
        </div>
      </journey-summary>
      <add-sessions-form>
        <pdk-grid
          class="govuk-grid-row"
          container=""
        >
          <pdk-grid
            class="govuk-grid-column-full"
            full=""
          >
            <div
              class="add-session pdk-!-border-color-mid-grey govuk-!-margin-bottom-8"
              pdk-border-colour="mid-grey"
              pdk-margin-bottom="8"
            >
              <h2
                class="govuk-heading-m"
                pdk-typography="heading-medium"
              >
                 Session details 
              </h2>
              <form
                class="ng-untouched ng-pristine ng-valid"
                data-test-id="addSessionsForm"
                novalidate=""
                pdk-form=""
              >
                <pdk-grid
                  class="govuk-grid-row"
                  container=""
                >
                  <pdk-grid
                    class="govuk-grid-column-full"
                    full=""
                  >
                    <h3
                      class="govuk-heading-s"
                      pdk-typography="heading-small"
                    >
                      Courtroom details
                    </h3>
                  </pdk-grid>
                  <pdk-grid
                    class="govuk-grid-column-one-half"
                    one-half=""
                  >
                    <pdk-form-field
                      label="Courtroom"
                      labeltype="small"
                    >
                      <pdk-form-group
                        class="pdk-form-group"
                      >
                        <label
                          class="govuk-label govuk-label--s"
                          for="pdk-select-GENERATED_ID"
                        >
                           Courtroom 
                        </label>
                        <pdk-select
                          class="ng-untouched ng-pristine ng-valid"
                          justified=""
                          required=""
                        >
                          <select
                            class="govuk-select pdk-select--justified"
                            id="pdk-select-GENERATED_ID"
                            name="courtroomId"
                            required=""
                          >
                            <option
                              value="1"
                            >
                               Courtroom 1 
                            </option>
                            <option
                              value="2"
                            >
                               Courtroom 2 
                            </option>
                            <option
                              value="3"
                            >
                               Courtroom 3 
                            </option>
                          </select>
                        </pdk-select>
                      </pdk-form-group>
                    </pdk-form-field>
                  </pdk-grid>
                  <pdk-grid
                    class="govuk-grid-column-full"
                    full=""
                  />
                  <pdk-grid
                    class="govuk-grid-column-one-half"
                    one-half=""
                  >
                    <pdk-form-field
                      label="Session and duration"
                      labeltype="small"
                    >
                      <pdk-form-group
                        class="pdk-form-group"
                      >
                        <fieldset
                          class="govuk-fieldset"
                          pdk-fieldset=""
                        >
                          <legend
                            class="govuk-fieldset__legend govuk-fieldset__legend--s"
                          >
                             Session and duration 
                          </legend>
                          <details
                            class="govuk-!-margin-bottom-2 govuk-details"
                            pdk-details=""
                            pdk-margin-bottom="2"
                          >
                            <summary
                              class="govuk-details__summary"
                            >
                              <span
                                class="govuk-details__summary-text"
                              >
                                National standard times
                              </span>
                            </summary>
                            <pdk-details-text
                              class="govuk-details__text"
                            >
                              <p>
                                 AM: 10:00am to 13:00pm 
                              </p>
                              <p>
                                 PM: 14:00pm to 17:00pm 
                              </p>
                              <p>
                                 All day: 10:00am to 17:00pm 
                              </p>
                            </pdk-details-text>
                          </details>
                          <pdk-radio-group
                            class="ng-untouched ng-pristine ng-valid"
                            name="sessionType"
                            required=""
                          >
                            <div
                              class="govuk-radios"
                            >
                              <pdk-radio-button
                                value="AM"
                              >
                                <div
                                  class="govuk-radios__item"
                                >
                                  <input
                                    class="govuk-radios__input"
                                    id="pdk-radio-GENERATED_ID"
                                    name="pdk-radio-group-GENERATED_ID"
                                    type="radio"
                                    value="AM"
                                  />
                                  <label
                                    class="govuk-radios__label govuk-label"
                                    for="pdk-radio-GENERATED_ID"
                                    pdk-label=""
                                  >
                                    AM
                                  </label>
                                </div>
                              </pdk-radio-button>
                              <pdk-radio-conditional>
                                <div
                                  class="govuk-radios__conditional"
                                >
                                  <pdk-form-field
                                    labeltype="small"
                                  >
                                    <pdk-form-group
                                      class="pdk-form-group"
                                    >
                                      <label
                                        class="govuk-label govuk-label--s"
                                        for="pdk-form-control-undefined-GENERATED_ID"
                                      >
                                         Enter session duration in minutes 
                                      </label>
                                      <pdk-hint
                                        class="govuk-hint"
                                      >
                                        <div>
                                           For example, 360 
                                        </div>
                                      </pdk-hint>
                                      <input
                                        class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-3"
                                        data-test-id="duration"
                                        id="pdk-form-control-undefined-GENERATED_ID"
                                        name="duration"
                                        pattern="[0-9]*"
                                        pdk-text-input=""
                                        required=""
                                        type="number"
                                      />
                                    </pdk-form-group>
                                  </pdk-form-field>
                                </div>
                              </pdk-radio-conditional>
                              <pdk-radio-button
                                value="PM"
                              >
                                <div
                                  class="govuk-radios__item"
                                >
                                  <input
                                    class="govuk-radios__input"
                                    id="pdk-radio-GENERATED_ID"
                                    name="pdk-radio-group-GENERATED_ID"
                                    type="radio"
                                    value="PM"
                                  />
                                  <label
                                    class="govuk-radios__label govuk-label"
                                    for="pdk-radio-GENERATED_ID"
                                    pdk-label=""
                                  >
                                    PM
                                  </label>
                                </div>
                              </pdk-radio-button>
                              <pdk-radio-button
                                value="AD"
                              >
                                <div
                                  class="govuk-radios__item"
                                >
                                  <input
                                    class="govuk-radios__input"
                                    id="pdk-radio-GENERATED_ID"
                                    name="pdk-radio-group-GENERATED_ID"
                                    type="radio"
                                    value="AD"
                                  />
                                  <label
                                    class="govuk-radios__label govuk-label"
                                    for="pdk-radio-GENERATED_ID"
                                    pdk-label=""
                                  >
                                    All day
                                  </label>
                                </div>
                              </pdk-radio-button>
                            </div>
                          </pdk-radio-group>
                        </fieldset>
                      </pdk-form-group>
                    </pdk-form-field>
                  </pdk-grid>
                  <pdk-grid
                    class="govuk-grid-column-one-half"
                    one-half=""
                  >
                    <pdk-form-field
                      label="Panel"
                      labeltype="small"
                    >
                      <pdk-form-group
                        class="pdk-form-group"
                      >
                        <fieldset
                          class="govuk-fieldset"
                          pdk-fieldset=""
                        >
                          <legend
                            class="govuk-fieldset__legend govuk-fieldset__legend--s"
                          >
                             Panel 
                          </legend>
                          <pdk-radio-group
                            class="ng-untouched ng-pristine ng-valid"
                            name="panelType"
                            required=""
                          >
                            <div

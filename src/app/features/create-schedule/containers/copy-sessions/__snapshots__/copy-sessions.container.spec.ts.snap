                            >
                              <pdk-checkbox
                                checkboxtype="small"
                                class="govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
                                name="selectAll"
                              >
                                <div
                                  class="govuk-checkboxes__item"
                                >
                                  <input
                                    class="govuk-checkboxes__input"
                                    id="pdk-checkbox-GENERATED_ID"
                                    name="selectAll"
                                    type="checkbox"
                                    value="true"
                                  />
                                  <label
                                    class="govuk-label govuk-checkboxes__label"
                                    for="pdk-checkbox-GENERATED_ID"
                                  >
                                    <span
                                      class="bold"
                                    >
                                      Select all
                                    </span>
                                  </label>
                                </div>
                              </pdk-checkbox>
                              <pdk-checkbox
                                class="govuk-checkboxes govuk-checkboxes--small"
                              >
                                <div
                                  class="govuk-checkboxes__item"
                                >
                                  <input
                                    class="govuk-checkboxes__input"
                                    id="pdk-checkbox-GENERATED_ID"
                                    name="pdk-checkbox-group-GENERATED_ID"
                                    type="checkbox"
                                    value="MON"
                                  />
                                  <label
                                    class="govuk-label govuk-checkboxes__label"
                                    for="pdk-checkbox-GENERATED_ID"
                                  >
                                    <span>
                                      Monday
                                    </span>
                                  </label>
                                </div>
                              </pdk-checkbox>
                              <pdk-checkbox
                                class="govuk-checkboxes govuk-checkboxes--small"
                              >
                                <div
                                  class="govuk-checkboxes__item"
                                >
                                  <input
                                    class="govuk-checkboxes__input"
                                    id="pdk-checkbox-GENERATED_ID"
                                    name="pdk-checkbox-group-GENERATED_ID"
                                    type="checkbox"
                                    value="TUE"

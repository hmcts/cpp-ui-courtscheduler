                  </pdk-grid>
                  <pdk-grid
                    class="govuk-!-padding-left-3 govuk-grid-column-full"
                    full=""
                    pdk-padding-left="3"
                  >
                    <h3
                      class="govuk-heading-s"
                      pdk-typography="heading-small"
                    >
                      Repeat sessions
                    </h3>
                    <pdk-form-field
                      label="Every"
                      labeltype="small"
                    >
                      <pdk-form-group
                        class="pdk-form-group"
                      >
                        <fieldset
                          class="govuk-fieldset"
                          pdk-fieldset=""
                        >
                          <legend
                            class="govuk-fieldset__legend govuk-fieldset__legend--s"
                          >
                             Every 
                          </legend>
                          <pdk-checkbox-group
                            checkboxtype="small"
                            class="ng-untouched ng-pristine ng-valid"
                            name="repeatDays"
                            required=""
                          >

                                    id="pdk-radio-GENERATED_ID"
                                    name="pdk-radio-group-GENERATED_ID"
                                    type="radio"
                                    value="ADULT"
                                  />
                                  <label
                                    class="govuk-radios__label govuk-label"
                                    for="pdk-radio-GENERATED_ID"
                                    pdk-label=""
                                  >
                                     Adult 
                                  </label>
                                </div>
                              </pdk-radio-button>
                              <pdk-radio-button>
                                <div
                                  class="govuk-radios__item"
                                >
                                  <input
                                    class="govuk-radios__input"
                                    id="pdk-radio-GENERATED_ID"
                                    name="pdk-radio-group-GENERATED_ID"
                                    type="radio"
                                    value="YOUTH"
                                  />
                                  <label
                                    class="govuk-radios__label govuk-label"
                                    for="pdk-radio-GENERATED_ID"
                                    pdk-label=""
                                  >
                                     Youth 
                                  </label>
                                </div>
                              </pdk-radio-button>
                            </div>
                          </pdk-radio-group>
                        </fieldset>
                      </pdk-form-group>
                    </pdk-form-field>
                  </pdk-grid>
                  <pdk-grid
                    class="govuk-grid-column-full"
                    full=""
                  >
                    <pdk-divider>
                      <hr
                        class="pdk-divider"
                      />
                    </pdk-divider>
                  </pdk-grid>
                  <pdk-grid
                    class="govuk-!-padding-left-3 govuk-grid-column-full"
                    full=""
                    pdk-padding-left="3"
                  >
                    <pdk-form-field
                      label="Additional session options"
                      labeltype="small"
                    >
                      <pdk-form-group
                        class="pdk-form-group"
                      >
                        <fieldset
                          class="govuk-fieldset"
                          pdk-fieldset=""
                        >
                          <legend
                            class="govuk-fieldset__legend govuk-fieldset__legend--s"
                          >
                             Additional session options 
                          </legend>
                          <pdk-checkbox-group
                            class="ng-untouched ng-pristine ng-valid"
                            name="additionalSessionOptions"
                            ngmodel=""
                          >
                            <div
                              class="govuk-checkboxes"
                            >
                              <pdk-checkbox
                                checkboxtype="small"
                                class="govuk-!-padding-top-2 govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
                                name="customTimes"
                                pdk-padding-top="2"
                              >
                                <div
                                  class="govuk-checkboxes__item"
                                >
                                  <input
                                    class="govuk-checkboxes__input"
                                    id="pdk-checkbox-GENERATED_ID"
                                    name="customTimes"
                                    type="checkbox"
                                    value="true"
                                  />
                                  <label
                                    class="govuk-label govuk-checkboxes__label"
                                    for="pdk-checkbox-GENERATED_ID"
                                  >
                                     Set custom session timings 
                                  </label>
                                </div>
                              </pdk-checkbox>
                              <pdk-checkbox
                                checkboxtype="small"
                                class="govuk-!-padding-top-2 govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
                                name="isOverbookingAllowed"
                                pdk-padding-top="2"
                              >
                                <div
                                  class="govuk-checkboxes__item"
                                >
                                  <input
                                    class="govuk-checkboxes__input"
                                    id="pdk-checkbox-GENERATED_ID"
                                    name="isOverbookingAllowed"
                                    type="checkbox"
                                    value="true"
                                  />
                                  <label
                                    class="govuk-label govuk-checkboxes__label"
                                    for="pdk-checkbox-GENERATED_ID"
                                  >
                                     Overbooking is allowed for this session 
                                  </label>
                                </div>
                              </pdk-checkbox>
                            </div>
                          </pdk-checkbox-group>
                        </fieldset>
                      </pdk-form-group>
                    </pdk-form-field>
                  </pdk-grid>
                  <pdk-grid

>
  <div
    class="govuk-!-margin-bottom-4"
    pdk-margin-bottom="4"
  >
    <a
      class="govuk-back-link"
      href="javascript:void(0);"
      pdk-back-link=""
    >
      Back 
    </a>
  </div><pdk-grid
    class="govuk-grid-row"
    container=""
  >
    <pdk-grid
      class="govuk-grid-column-full"
      full=""
    >
      <h1
        class="govuk-heading-xl"
        pdk-typography="heading-xlarge"
      >
        Select business type
      </h1>
      <journey-summary
        headingtext="Court details"
      >
        <div
          class="govuk-!-margin-bottom-8"
          pdk-margin-bottom="8"
        >
          <h3
            class="govuk-!-margin-bottom-0"
            pdk-margin-bottom="0"
            pdk-typography="heading-medium"
          >
            Court details
          </h3>
          <dl
            class="pdk-summary-list"
            pdk-summary-list=""
          >
            <div
              class="pdk-summary-list__row"
              pdk-summary-list-item=""
            >
              <dt
                class="pdk-summary-list__key"
                pdk-summary-list-key=""
              >
                Court
              </dt>
              <dd
                class="pdk-summary-list__value"
                pdk-summary-list-value=""
              >
                L3 Name
              </dd>
            </div>
            <div
              class="pdk-summary-list__row"
              pdk-summary-list-item=""
            >
              <dt
                class="pdk-summary-list__key"
                pdk-summary-list-key=""
              >
                Business Type
              </dt>
              <dd
                class="pdk-summary-list__value"
                pdk-summary-list-value=""
              >
                Business Type 1
              </dd>
            </div>
          </dl>
        </div>
      </journey-summary>
    </pdk-grid>
    <pdk-grid
      class="govuk-grid-column-one-half"
      one-half=""
    >
      <select-business-type-form>
        <form
          class="ng-untouched ng-pristine ng-valid"
          data-test-id="selectBusinessType"
          novalidate=""
          pdk-form=""
        >
          <pdk-form-field
            label="Select business type"
            labeltype="small"
          >
            <pdk-form-group
              class="pdk-form-group"
            >
              <label
                class="govuk-label govuk-label--s"
                for="pdk-form-control-undefined-GENERATED_ID"
              >
                 Select business type 
              </label>
              <cpp-rota-business-type-select
                class="ng-untouched ng-pristine ng-valid"
                justified=""
                required=""
              >
                <pdk-select>
                  <select
                    class="govuk-select pdk-select--justified"
                    id="pdk-form-control-undefined-GENERATED_ID"
                    name="rotaBusinessTypeCode"
                    required=""
                  >
                    <option
                      value="001"
                    >
                       Magistrates Business Type 1 
                    </option>
                  </select>
                </pdk-select>
              </cpp-rota-business-type-select>
            </pdk-form-group>
          </pdk-form-field>
          <div
            class="actions"
          >
            <pdk-form-group
              class="pdk-form-group"
            >
              <button
                class="govuk-!-margin-bottom-0 govuk-button"
                data-test-id="select-business-type"
                pdk-button=""
                pdk-margin-bottom="0"
                type="submit"
              >
                 Continue 
              </button>
            </pdk-form-group>
            <div
              class="govuk-!-margin-left-4"
              pdk-margin-left="4"
            >
              <a
                class="govuk-link"
                data-test-id="clear-court"
                href="javascript:void(0)"
                pdk-link=""
              >
                Clear
              </a>
            </div>
          </div>
        </form>
      </select-business-type-form>
    </pdk-grid>
  </pdk-grid>
</select-business-type-container>
`;


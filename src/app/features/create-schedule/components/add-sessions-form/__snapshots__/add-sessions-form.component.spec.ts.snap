                    </pdk-radio-group>
                  </fieldset>
                </pdk-form-group>
              </pdk-form-field>
            </pdk-grid>
            <pdk-grid
              class="govuk-grid-column-one-half"
              one-half=""
            >
              <pdk-form-field
                label="Panel"
                labeltype="small"
              >
                <pdk-form-group
                  class="pdk-form-group"
                >
                  <fieldset
                    class="govuk-fieldset"
                    pdk-fieldset=""
                  >

                        <pdk-checkbox
                          checkboxtype="small"
                          class="govuk-!-padding-top-2 govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
                          name="isOverbookingAllowed"
                          pdk-padding-top="2"
                        >
                          <div
                            class="govuk-checkboxes__item"
                          >
                            <input
                              class="govuk-checkboxes__input"
                              id="pdk-checkbox-GENERATED_ID"
                              name="isOverbookingAllowed"
                              type="checkbox"
                              value="true"

                              class="govuk-checkboxes__input"
                              id="pdk-checkbox-GENERATED_ID"
                              name="pdk-checkbox-group-GENERATED_ID"
                              type="checkbox"
                              value="MON"
                            />
                            <label
                              class="govuk-label govuk-checkboxes__label"
                              for="pdk-checkbox-GENERATED_ID"
                            >
                              <span>
                                Monday
                              </span>
                            </label>
                          </div>
                        </pdk-checkbox>
                        <pdk-checkbox
                          class="govuk-checkboxes govuk-checkboxes--small"
                        >
                          <div
                            class="govuk-checkboxes__item"
                          >
                            <input
                              class="govuk-checkboxes__input"
                              id="pdk-checkbox-GENERATED_ID"
                              name="pdk-checkbox-group-GENERATED_ID"
                              type="checkbox"
                              value="TUE"
                            />
                            <label
                              class="govuk-label govuk-checkboxes__label"
                              for="pdk-checkbox-GENERATED_ID"
                            >
                              <span>
                                Tuesday
                              </span>
                            </label>
                          </div>
                        </pdk-checkbox>
                        <pdk-checkbox
                          class="govuk-checkboxes govuk-checkboxes--small"
                        >
                          <div
                            class="govuk-checkboxes__item"
                          >
                            <input
                              class="govuk-checkboxes__input"
                              id="pdk-checkbox-GENERATED_ID"
                              name="pdk-checkbox-group-GENERATED_ID"
                              type="checkbox"
                              value="WED"
                            />
                            <label
                              class="govuk-label govuk-checkboxes__label"
                              for="pdk-checkbox-GENERATED_ID"
                            >
                              <span>
                                Wednesday
                              </span>
                            </label>
                          </div>
                        </pdk-checkbox>
                        <pdk-checkbox
                          class="govuk-checkboxes govuk-checkboxes--small"
                        >
                          <div
                            class="govuk-checkboxes__item"
                          >
                            <input
                              class="govuk-checkboxes__input"
                              id="pdk-checkbox-GENERATED_ID"
                              name="pdk-checkbox-group-GENERATED_ID"
                              type="checkbox"
                              value="THU"
                            />
                            <label
                              class="govuk-label govuk-checkboxes__label"
                              for="pdk-checkbox-GENERATED_ID"
                            >
                              <span>
                                Thursday
                              </span>
                            </label>
                          </div>

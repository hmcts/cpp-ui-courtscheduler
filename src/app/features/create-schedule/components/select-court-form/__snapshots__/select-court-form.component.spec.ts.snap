                      pdk-label=""
                    >
                      Crown Court 
                    </label>
                  </div>
                </pdk-radio-button>
              </div>
            </pdk-radio-group>
          </fieldset>
        </pdk-form-group>
      </pdk-form-field>
    </select-jurisdiction>
    <div
      class="actions"
    >
      <pdk-form-group
        class="pdk-form-group"
      >
        <button
          class="govuk-!-margin-bottom-0 govuk-button"
          data-test-id="select-court"
          pdk-button=""
          pdk-margin-bottom="0"
          type="submit"
        >
           Continue 
        </button>
      </pdk-form-group>
      <div
        class="govuk-!-margin-left-4"
        pdk-margin-left="4"
      >
        <a
          class="govuk-link"
          data-test-id="clear-court"
          href="javascript:void(0)"
          pdk-link=""
        >
          Clear
        </a>
      </div>
    </div>
  </form>
</select-court-form>
`;

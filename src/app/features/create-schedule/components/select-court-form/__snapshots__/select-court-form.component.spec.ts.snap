// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`SelectCourtFormComponent should create 1`] = `
<select-court-form
  JurisdictionType={[Function Object]}
  courtCentre={[Function Function]}
  courtCentreChange={[Function OutputEmitterRef]}
  errors={[Function OutputEmitterRef]}
  form={[Function Function]}
  jurisdiction={[Function Function]}
  jurisdictionCode={[Function Function]}
>
  <form
    class="ng-untouched ng-pristine ng-valid"
    data-test-id="select-court-form"
    novalidate=""
    pdk-form=""
  >
    <select-jurisdiction>
      <pdk-form-field
        label="Select jurisdiction"
        labeltype="small"
      >
        <pdk-form-group
          class="pdk-form-group"
        >
          <fieldset
            class="govuk-fieldset"
            pdk-fieldset=""
          >
            <legend
              class="govuk-fieldset__legend govuk-fieldset__legend--s"
            >
               Select jurisdiction 
            </legend>
            <pdk-radio-group
              class="ng-untouched ng-pristine ng-invalid"
              name="jurisdictionType"
              required=""
            >
              <div
                class="govuk-radios"
              >
                <pdk-radio-button>
                  <div
                    class="govuk-radios__item"
                  >
                    <input
                      class="govuk-radios__input"
                      id="pdk-radio-GENERATED_ID"
                      name="pdk-radio-group-GENERATED_ID"
                      type="radio"
                      value="MAGISTRATES"
                    />
                    <label
                      class="govuk-radios__label govuk-label"
                      for="pdk-radio-GENERATED_ID"
                      pdk-label=""
                    >
                      Magistrates' Court 
                    </label>
                  </div>
                </pdk-radio-button>
                <pdk-radio-conditional>
                  <div
                    class="govuk-radios__conditional"
                  >
                  </div>
                </pdk-radio-conditional>
                <pdk-radio-button>
                  <div
                    class="govuk-radios__item"
                  >
                    <input
                      class="govuk-radios__input"
                      id="pdk-radio-GENERATED_ID"
                      name="pdk-radio-group-GENERATED_ID"
                      type="radio"
                      value="CROWN"
                    />
                    <label
                      class="govuk-radios__label govuk-label"
                      for="pdk-radio-GENERATED_ID"
                      pdk-label=""
                    >
                      Crown Court 
                    </label>
                  </div>
                </pdk-radio-button>
              </div>
            </pdk-radio-group>
          </fieldset>
        </pdk-form-group>
      </pdk-form-field>
    </select-jurisdiction>
    <div
      class="actions"
    >
      <pdk-form-group
        class="pdk-form-group"
      >
        <button
          class="govuk-!-margin-bottom-0 govuk-button"
          data-test-id="select-court"
          pdk-button=""
          pdk-margin-bottom="0"
          type="submit"
        >
           Continue 
        </button>
      </pdk-form-group>
      <div
        class="govuk-!-margin-left-4"
        pdk-margin-left="4"
      >
        <a
          class="govuk-link"
          data-test-id="clear-court"
          href="javascript:void(0)"
          pdk-link=""
        >
          Clear
        </a>
      </div>
    </div>
  </form>
</select-court-form>
`;

exports[`SelectCourtFormComponent should create with crown jurisdiction selected 1`] = `
<select-court-form
  JurisdictionType={[Function Object]}
  courtCentre={[Function Function]}

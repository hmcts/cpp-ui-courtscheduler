              data-test-id="sessionType"
              pdk-table-cell=""
            >
              <span>
                AM
              </span>
            </td>
            <td
              class="govuk-table__cell"
              data-test-id="panelType"
              pdk-table-cell=""
            >
               Adult 
            </td>
            <td

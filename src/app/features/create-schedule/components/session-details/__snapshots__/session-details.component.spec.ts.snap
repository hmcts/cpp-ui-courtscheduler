            </td>
            <td
              class="govuk-table__cell"
              data-test-id="panelType"
              pdk-table-cell=""
            >
               Youth 
            </td>
            <td
              class="govuk-table__cell"
              data-test-id="businessType"
              pdk-table-cell=""
            >
               Business Type 2 
            </td>
            <td
              class="govuk-table__cell"
              data-test-id="duration"
              pdk-table-cell=""
            >
              <div>
                <span>
                  Duration - 
                </span>
                <span>
                  1 hour 30 minutes
                </span>
              </div>
            </td>
            <td
              class="govuk-table__cell"
              data-test-id="repeatDays"
              pdk-table-cell=""
            >
               Tuesday 
            </td>
            <td
              class="govuk-table__cell"
              data-test-id="overbooking"
              pdk-table-cell=""
            >
               No 
            </td>

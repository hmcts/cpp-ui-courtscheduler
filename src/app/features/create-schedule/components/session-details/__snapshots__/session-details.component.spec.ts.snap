              aria-sort="none"
              class="pdk-sortable pdk-sortable_order govuk-table__cell"
              pdk-sortable-header=""
              pdk-table-header=""
              scope="col"
            >
              <button
                type="button"
              >
                 Session 
              </button>
            </th>
            <th
              aria-sort="none"
              class="pdk-sortable pdk-sortable_order govuk-table__cell"
              pdk-sortable-header=""
              pdk-table-header=""
              scope="col"
            >
              <button
                type="button"
              >
                 Panel 
              </button>
            </th>
            <th
              class="govuk-table__cell"
              pdk-table-header=""
              scope="col"
            >
              Type
            </th>
            <th
              class="govuk-table__cell"
              pdk-table-header=""
              scope="col"
            >
              Total capacity
            </th>
            <th
              class="govuk-table__cell"
              pdk-table-header=""
              scope="col"
            >
              Repeat on
            </th>
            <th
              class="govuk-table__cell"
              pdk-table-header=""
              scope="col"
            >
              Overbooking
            </th>
            <th
              class="govuk-table__cell"
              pdk-table-header=""
              scope="col"
            >
              Actions
            </th>
          </tr>
        </thead>
        <tbody
          class="govuk-table__body"
          pdk-table-body=""
        >
          <tr
            class="govuk-table__row"
            data-test-id="sessionDetailsTableItem"
            pdk-table-row=""
          >
            <td
              class="govuk-table__cell"
              data-test-id="courtroom"
              pdk-table-cell=""
            >

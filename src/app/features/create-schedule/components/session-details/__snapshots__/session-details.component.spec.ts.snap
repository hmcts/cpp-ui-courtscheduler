    container=""
    data-test-id="sessionDetails"
    pdk-grid=""
    pdk-margin-bottom="8"
  >
    <pdk-grid
      class="govuk-grid-column-full"
      full=""
    >
      <h2
        class="govuk-!-margin-bottom-0 govuk-heading-m"
        pdk-margin-bottom="0"
        pdk-typography="heading-medium"
      >
        Session details
      </h2>

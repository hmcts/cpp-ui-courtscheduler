                </a>
              </div>
            </td>
          </tr>
          <tr
            class="govuk-table__row"
            data-test-id="sessionDetailsTableItem"
            pdk-table-row=""
          >
            <td
              class="govuk-table__cell"
              data-test-id="courtroom"
              pdk-table-cell=""
            >
               Courtroom 2 
            </td>
            <td
              class="govuk-table__cell"
